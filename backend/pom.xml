<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.xiaou61</groupId>
  <artifactId>paideia</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Paideia</name>
  <description>Paideia 后端：千人千面 AI 个性化学习平台的架构底座</description>

  <modules>
    <module>paideia-platform</module>
    <module>paideia-web</module>
    <module>paideia-persistence</module>
    <module>paideia-security</module>
    <module>paideia-account</module>
    <module>paideia-knowledge</module>
    <module>paideia-ai</module>
    <module>paideia-app</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-account</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-knowledge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xiaou61</groupId>
        <artifactId>paideia-ai</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
